SELECT 
    p.id_pedido AS 'Número do Pedido',
    c.nome AS 'Nome do Cliente',
    c.email AS 'E-mail',
    p.data_pedido AS 'Data da Compra',
    p.total AS 'Valor Total (R$)'
FROM pedidos p
JOIN clientes c ON p.id_cliente = c.id_cliente;
